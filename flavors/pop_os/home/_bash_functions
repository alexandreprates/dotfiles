# Autoload conda or venv when changing directories
cd() {
  builtin cd $@
  [ -f .conda_env ] && conda activate $(cat .conda_env)
  [ -f .venv ] && source .venv/bin/activate
}

md5_rename() {
    prefix=""
    filter="*"
    target_dir=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --prefix)
                prefix="$2"
                shift 2
                ;;
            --filter)
                filter="$2"
                shift 2
                ;;
            *)
                target_dir="$1"
                shift
                ;;
        esac
    done

    if [ -z "$target_dir" ]; then
        echo "Usage: md5_rename [--prefix <prefix>] [--filter <pattern>] <path>"
        return 1
    fi

    if [ ! -d "$target_dir" ]; then
        echo "Dir '$target_dir' not exists."
        return 1
    fi

    cd "$target_dir" || return 1

    for filename in $filter; do
        # Check for regular file
        if [ -f "$filename" ]; then
            filehash=$(md5sum "$filename" | awk '{ print $1 }')
            fileext="${filename##*.}"
            mv -v "$filename" "${prefix}${filehash}.${fileext}"
        fi
    done
}

download() {
	URL=$1
	FILENAME=$(echo $URL | rev | cut -d \/ -f 1 | rev | cut -d \? -f 1)

	aria2c "$URL" -o "$FILENAME"
}

bw2secrets() {
    if [ $# -ne 1 ]; then
        printf "Usage: bw2secrets <name>\n" >&2
        return 1
    fi

    local name="$1"
    local secrets_file="$HOME/.bash_secrets"

    # Search for the export field in Bitwarden
    local export_value=$(bw list items --search "$name" | jq -r '.[].fields[]? | select(.name=="export") | .value' 2>/dev/null)

    if [ -z "$export_value" ]; then
        printf "No 'export' field found for item: %s\n" "$name" >&2
        return 1
    fi

    # Create secrets file if it doesn't exist
    touch "$secrets_file"

    # Extract variable name from export statement (assumes format: export VAR_NAME=...)
    local var_name=$(printf "%s" "$export_value" | grep -o '^export [A-Z_][A-Z0-9_]*' | cut -d' ' -f2)

    if [ -n "$var_name" ]; then
        # Remove existing export for this variable if it exists (compatible with both GNU and BSD sed)
        sed -i.bak "/^export $var_name=/d" "$secrets_file" 2>/dev/null && rm -f "$secrets_file.bak"
    fi

    # Add the new export to the file
    printf "%s\n" "$export_value" >> "$secrets_file"

    printf "Export added to %s:\n" "$secrets_file" >&2
}

py() {
  local bin
  if command -v python >/dev/null 2>&1; then
    bin=python
  elif command -v python3 >/dev/null 2>&1; then
    bin=python3
  else
    echo "py: Python não encontrado (nem 'python' nem 'python3' no PATH)" >&2
    return 127
  fi

  command "$bin" "$@"
}

# synchronize local directory with remote and watch for changes
mirror() {
    if [ $# -ne 3 ]; then
        echo "Usage: mirror <source_dir> <remote_host> <remote_dir>"
        echo "  source_dir:  Local directory to sync (e.g., ./project)"
        echo "  remote_host: Remote host (e.g., user@hostname)"
        echo "  remote_dir:  Remote directory path (e.g., /home/user/project)"
        return 1
    fi

    local source_dir="$1"
    local remote_host="$2"
    local remote_dir="$3"

    # Validate source directory exists
    if [ ! -d "$source_dir" ]; then
        echo "Error: Source directory '$source_dir' does not exist"
        return 1
    fi

    # Check if rsync is installed
    if ! command -v rsync >/dev/null 2>&1; then
        echo "Error: rsync is not installed. Please install it with: sudo apt install rsync"
        return 1
    fi

    # Prefer Linux-native watcher; fallback to fswatch when available
    local watcher
    if command -v inotifywait >/dev/null 2>&1; then
        watcher="inotifywait"
    elif command -v fswatch >/dev/null 2>&1; then
        watcher="fswatch"
    else
        echo "Error: no filesystem watcher found."
        echo "Install one of:"
        echo "  sudo apt install inotify-tools"
        echo "  sudo apt install fswatch"
        return 1
    fi

    echo "Starting mirror..."
    echo "Source: $source_dir"
    echo "Remote: $remote_host:$remote_dir"
    echo ""

    # Function to perform sync
    sync_files() {
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Syncing files..."
        if rsync -avz --delete "$source_dir/" "$remote_host:$remote_dir/"; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] Sync completed successfully"
        else
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] Sync failed"
        fi
        echo ""
    }

    # Initial sync
    echo "Performing initial sync..."
    sync_files

    # Watch for changes and sync automatically
    echo "Watching for changes in '$source_dir'..."
    echo "Press Ctrl+C to stop watching"
    echo ""

    if [ "$watcher" = "inotifywait" ]; then
        # Linux-native watcher (inotify-tools)
        inotifywait -mrq \
            --event modify,create,delete,move \
            --exclude '(^|/)(\.git|node_modules|__pycache__)(/|$)|\.swp$|\.tmp$|\.pyc$|\.DS_Store$' \
            "$source_dir" | while read -r _; do
            sync_files
        done
    else
        # Fallback watcher (fswatch)
        fswatch -r -l 1 \
            -e "\.git/" \
            -e "\.DS_Store" \
            -e "\.swp$" \
            -e "\.tmp$" \
            -e "__pycache__/" \
            -e "\.pyc$" \
            -e "node_modules/" \
            "$source_dir" | while read -r _; do
            sync_files
        done
    fi
}
