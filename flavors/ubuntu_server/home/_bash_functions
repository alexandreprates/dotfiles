# Autoload conda or venv when changing directories
cd() {
  builtin cd $@
  [ -f .conda_env ] && conda activate $(cat .conda_env)
  [ -f .venv ] && source .venv/bin/activate
}

md5_rename() {
    if [ $# -ne 1 ]; then
        echo "Usage: md5_rename <path>"
        return 1
    fi

    target_dir="$1"

    if [ ! -d "$target_dir" ]; then
        echo "Dir '$target_dir' not exists."
        return 1
    fi

    cd "$target_dir" || return 1

    for filename in *; do
        # Check for regular file
        if [ -f "$filename" ]; then
            filehash=$(md5sum "$filename" | awk '{ print $1 }')
            fileext="${filename##*.}"
            mv -v "$filename" "${filehash}.${fileext}"
        fi
    done
}

download() {
	URL=$1
	FILENAME=$(echo $URL | rev | cut -d \/ -f 1 | rev | cut -d \? -f 1)

	aria2c "$URL" -o "$FILENAME"
}

bw2secrets() {
    if [ $# -ne 1 ]; then
        printf "Usage: bw2secrets <name>\n" >&2
        return 1
    fi

    local name="$1"
    local secrets_file="$HOME/.bash_secrets"

    # Search for the export field in Bitwarden
    local export_value=$(bw list items --search "$name" | jq -r '.[].fields[]? | select(.name=="export") | .value' 2>/dev/null)

    if [ -z "$export_value" ]; then
        printf "No 'export' field found for item: %s\n" "$name" >&2
        return 1
    fi

    # Create secrets file if it doesn't exist
    touch "$secrets_file"

    # Extract variable name from export statement (assumes format: export VAR_NAME=...)
    local var_name=$(printf "%s" "$export_value" | grep -o '^export [A-Z_][A-Z0-9_]*' | cut -d' ' -f2)

    if [ -n "$var_name" ]; then
        # Remove existing export for this variable if it exists (compatible with both GNU and BSD sed)
        sed -i.bak "/^export $var_name=/d" "$secrets_file" 2>/dev/null && rm -f "$secrets_file.bak"
    fi

    # Add the new export to the file
    printf "%s\n" "$export_value" >> "$secrets_file"

    printf "Export added to %s:\n" "$secrets_file" >&2
}
